{
  "name": "saydo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "eval": "tsx evals/run-local.ts",
    "eval:fails": "tsx evals/run-local.ts --fails --heldout",
    "eval:ai": "tsx evals/run-ai.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.api.json",
    "test:api": "tsx scripts/api-test.ts"
  },
  "dependencies": {
    "chrono-node": "^2.10.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rrule": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^32.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "description": "Voice to-do list that understands English, Hindi and Hinglish",
  "engines": {
    "node": ">=20"
  }
}
